{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components": ["./src/components"],
      "@constants": ["./src/constants"],
      "@hooks/*": ["./src/hooks/*"],
      "@navigation": ["./src/navigation"],
      "@screens/*": ["./src/screens/*"],
      "@theme": ["./src/theme"],
      "@types": ["./src/types"],
      "@utils": ["./src/utils"]
    }
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
